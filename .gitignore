target/
*.class
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# --- Node / web ---
node_modules/
dist/
coverage/
*.tsbuildinfo

# --- Python ---
__pycache__/
*.pyc
.venv/
.venv-*/
.pytest_cache/

# --- CDK ---
cdk.out/

# --- build artifacts (không commit gói deploy) ---
*.zip
*.jar
!**/.mvn/wrapper/*.jar

