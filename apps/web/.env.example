# Copy to .env.local (git-ignored) and fill in. Nothing here is a secret: the app client is public (PKCE),
# so there is no client secret anywhere in the web app.

# Cognito user pool and its SPA app client (stack outputs of JarsAuth / JarsApp)
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Managed login domain without scheme, e.g. <prefix>.auth.ap-southeast-1.amazoncognito.com
VITE_COGNITO_DOMAIN=

# Local development without Cognito (dev server only, removed from production builds): the app asks
# POST /dev/token for an access token of this subject and skips the login screen.
# The backend must run with the `local` profile and jars.security.local-dev-tokens=true.
VITE_DEV_TOKEN_SUB=
