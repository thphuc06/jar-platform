<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.thphuc06</groupId>
    <artifactId>jars-infra</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>jars-infra</name>
    <description>Jars Platform - AWS CDK (Java) infrastructure</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Java 21 LTS: see docs/04-adr/0019. The CDK app only needs to run on the same JDK as jars-api. -->
        <maven.compiler.release>21</maven.compiler.release>

        <!--
            Versions are exact on purpose: an infrastructure build must be reproducible.
            Each one is the newest stable release that was at least two weeks old on 2026-11-12
            (aws-cdk-lib 2.276.0 is only two days old, so 2.275.0 is used).
        -->
        <aws-cdk-lib.version>2.275.0</aws-cdk-lib.version>
        <constructs.version>10.8.1</constructs.version>
        <cdk-nag.version>3.0.2</cdk-nag.version>
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>

        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <exec-maven-plugin.version>3.7.0</exec-maven-plugin.version>

        <jars.infra.main-class>io.github.thphuc06.jars.infra.JarsInfraApp</jars.infra.main-class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>software.amazon.awscdk</groupId>
            <artifactId>aws-cdk-lib</artifactId>
            <version>${aws-cdk-lib.version}</version>
        </dependency>
        <dependency>
            <groupId>software.constructs</groupId>
            <artifactId>constructs</artifactId>
            <version>${constructs.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.cdklabs</groupId>
            <artifactId>cdknag</artifactId>
            <version>${cdk-nag.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- parses the ADOT collector configuration in tests; same version as the jackson-databind that jsii brings -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>2.22.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>

            <!-- `cdk synth` runs the app through this plugin (see cdk.json and scripts/cdk-app.mjs) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <configuration>
                    <mainClass>${jars.infra.main-class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
